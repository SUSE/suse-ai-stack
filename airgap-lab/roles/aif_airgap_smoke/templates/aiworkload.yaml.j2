apiVersion: ai-factory.suse.com/v1alpha1
kind: AIWorkload
metadata:
  name: {{ smoke_case_id }}
  namespace: {{ smoke_namespace }}
  labels:
    airgap-lab.suse.com/case: {{ smoke_case_id }}
    airgap-lab.suse.com/source: {{ smoke_blueprint_mode }}-matrix
spec:
  displayName: {{ smoke_display_name | quote }}
  source:
    sourceType: Blueprint
    blueprint:
      name: {{ smoke_blueprint_reference_name }}
      version: 0.1.0
  targetNamespace: {{ smoke_namespace }}
  targetClusters:
{% for cluster_id in smoke_target_clusters %}
    - {{ cluster_id | quote }}
{% endfor %}
  deployStrategy: {{ smoke_strategy }}
