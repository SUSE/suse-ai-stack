apiVersion: ai-factory.suse.com/v1alpha1
kind: Blueprint
metadata:
  name: {{ smoke_blueprint_resource_name }}
  labels:
    ai-factory.suse.com/blueprint-name: {{ smoke_blueprint_reference_name }}
    ai-factory.suse.com/blueprint-version: {{ smoke_chart_version | quote }}
    airgap-lab.suse.com/source: rendered-matrix
    airgap-lab.suse.com/case: {{ smoke_case_id }}
spec:
  displayName: {{ smoke_display_name | quote }}
  version: {{ smoke_chart_version | quote }}
  description: CPU-only chart used to prove private catalog, Fleet and registry paths.
  source: Custom
  components:
    - chartRepo: {{ smoke_chart_repo | quote }}
      chartName: airgap-smoke
      chartVersion: {{ smoke_chart_version | quote }}
      vendor: suse
      releaseName: {{ smoke_release_name | quote }}
      values:
        fullnameOverride: {{ smoke_workload_name }}-{{ smoke_strategy | lower }}
        image:
          registry: registry.suse.com
          repository: bci/bci-busybox
          tag: "15.7"
          pullPolicy: Always
