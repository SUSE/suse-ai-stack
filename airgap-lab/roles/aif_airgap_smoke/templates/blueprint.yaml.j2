apiVersion: ai-factory.suse.com/v1alpha1
kind: Blueprint
metadata:
  name: {{ smoke_workload_name }}-{{ smoke_strategy | lower }}-0-1-0
  labels:
    ai-factory.suse.com/blueprint-name: {{ smoke_workload_name }}-{{ smoke_strategy | lower }}
    ai-factory.suse.com/blueprint-version: 0.1.0
spec:
  displayName: AI Factory air-gap smoke
  version: 0.1.0
  description: CPU-only chart used to prove private catalog, Fleet and registry paths.
  source: Custom
  components:
    - chartRepo: application-collection
      chartName: airgap-smoke
      chartVersion: 0.1.0
      vendor: suse
      values:
        fullnameOverride: {{ smoke_workload_name }}-{{ smoke_strategy | lower }}
        image:
          registry: registry.suse.com
          repository: bci/bci-busybox
          tag: "15.7"
          pullPolicy: Always
