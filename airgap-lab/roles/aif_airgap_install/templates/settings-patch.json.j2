{
  "spec": {
    "fleet": {
      "repoURL": "{{ gitea_url }}/{{ gitea_admin_username }}/{{ gitea_repository }}.git",
      "branch": "main",
      "authType": "token",
      "credSecretRef": {
        "name": "gitops-credentials",
        "key": "token"
      }
    },
    "applicationCollection": {
      "userSecretRef": { "name": "harbor-credentials", "key": "username" },
      "tokenSecretRef": { "name": "harbor-credentials", "key": "password" }
    },
    "suseRegistry": {
      "userSecretRef": { "name": "harbor-credentials", "key": "username" },
      "tokenSecretRef": { "name": "harbor-credentials", "key": "password" }
    },
    "nvidia": {
      "userSecretRef": { "name": "harbor-credentials", "key": "username" },
      "tokenSecretRef": { "name": "harbor-credentials", "key": "password" }
    },
    "registryEndpoints": {
      "applicationCollection": "oci://{{ harbor_hostname }}/{{ appco_chart_project }}",
      "suseRegistry": "oci://{{ harbor_hostname }}/{{ suse_chart_project }}",
      "nvidia": "oci://{{ harbor_hostname }}/{{ nvidia_chart_project }}"
    }
  }
}
