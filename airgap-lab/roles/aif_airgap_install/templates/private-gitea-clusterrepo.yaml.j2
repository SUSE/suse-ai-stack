apiVersion: catalog.cattle.io/v1
kind: ClusterRepo
metadata:
  name: {{ gitea_chart_clusterrepo | quote }}
spec:
  gitRepo: "{{ gitea_url }}/{{ gitea_admin_username }}/{{ gitea_chart_repository }}.git"
  gitBranch: main
  clientSecret:
    name: "{{ gitea_chart_clusterrepo }}-auth"
    namespace: cattle-system
{% if gitea_tls_enabled | bool %}
  # Rancher's ClusterRepo API uses base64 DER here, unlike AIF/Fleet's PEM CA
  # fields. Supplying base64 PEM makes git fail while opening its temporary CA.
  caBundle: {{ private_gitea_clusterrepo_ca.stdout | quote }}
{% endif %}
