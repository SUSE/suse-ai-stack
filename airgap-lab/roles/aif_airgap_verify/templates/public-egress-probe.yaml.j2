apiVersion: v1
kind: Pod
metadata:
  name: aif-airgap-public-egress-probe
  namespace: {{ aif_namespace }}
  labels:
    app.kubernetes.io/name: aif-airgap-public-egress-probe
spec:
  restartPolicy: Never
  activeDeadlineSeconds: 45
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 65534
    runAsGroup: 65534
    seccompProfile:
      type: RuntimeDefault
  containers:
    - name: probe
      image: registry.suse.com/bci/bci-busybox:15.7
      imagePullPolicy: Always
      command: ["/bin/sh", "-ec"]
      args:
        - |
          if ! busybox nc -z -w 5 {{ airgap_services_address }} 443; then
            echo "internal Harbor TCP probe failed"
            exit 43
          fi
          if busybox nc -z -w 5 {{ airgap_probe_public_ipv4 }} {{ airgap_probe_public_port | int }}; then
            echo "PUBLIC EGRESS LEAK: TCP connection succeeded"
            exit 42
          fi
          echo "internal=reachable public=blocked"
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
        readOnlyRootFilesystem: true
      resources:
        requests:
          cpu: 5m
          memory: 8Mi
        limits:
          cpu: 50m
          memory: 32Mi
